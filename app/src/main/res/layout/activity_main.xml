<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                xmlns:tools="http://schemas.android.com/tools"
                android:orientation="vertical"
                android:padding="5dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/my_recycler_view"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/serviceInfo"/>

    <LinearLayout
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:id="@+id/serviceInfo"
        android:layout_above="@+id/buttonGroup2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/serviceInfoText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="18sp"
            android:textColor="@color/colorPrimary"
            tools:text="Right answers 78%" />

    </LinearLayout>


    <LinearLayout
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/buttonGroup2">

        <Button
            android:onClick="iDontKnowButtonAction"
            android:id="@+id/leftButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.26"
            android:text="@string/wrong_answer_button"
            />

        <Button
            android:onClick="iKnowButtonAction"
            android:id="@+id/rigthButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.26"
            android:text="@string/right_answer_button"
            />

        <Button
            android:onClick="previousButton"
            android:id="@+id/previousButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.19"
            android:text="@string/previous_button"
            />

        <Button
            android:onClick="nextButton"
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.19"
            android:text="@string/next_button"
            />

    </LinearLayout>

</RelativeLayout>
